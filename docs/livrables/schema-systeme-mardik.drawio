<mxfile host="app.diagrams.net" type="device"><diagram id="systeme-mardik" name="Systeme Mardik v2"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="920" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="&lt;b&gt;Mardik v2 — analyse de contrats&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;• Contrats (texte collé)&lt;br&gt;&amp;nbsp;&amp;nbsp;• Clauses — 14 types connus&lt;br&gt;&amp;nbsp;&amp;nbsp;• Score de confiance (par clause + global)&lt;br&gt;&amp;nbsp;&amp;nbsp;• Versions : v1 figée, v2 stable / canary&lt;br&gt;&amp;nbsp;&amp;nbsp;• Juristes (3) · chef de projet · dev" style="text;html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=12;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="360" height="125" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Cas d&#x27;usage :&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;• coller un contrat → clauses présentes + score&lt;br&gt;&amp;nbsp;&amp;nbsp;• savoir quand relire (score bas = alerte)&lt;br&gt;&amp;nbsp;&amp;nbsp;• livrer v2 sans jamais casser v1&lt;br&gt;&amp;nbsp;&amp;nbsp;• revenir en arrière en un clic" style="text;html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=12;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="155" width="360" height="100" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Chiffres :&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;• 3 juristes · 400 contrats/mois ≈ 20/jour&lt;br&gt;&amp;nbsp;&amp;nbsp;• contrat long : 30–40 p ≈ 100–120 k car. ≈ 25–30 k tokens&lt;br&gt;&amp;nbsp;&amp;nbsp;• v1 coupe à 16 000 car. → clauses de fin perdues&lt;br&gt;&amp;nbsp;&amp;nbsp;• p95 &amp;lt; 8 s · &amp;lt; 0,15 €/analyse → ≈ 60 €/mois&lt;br&gt;&amp;nbsp;&amp;nbsp;• plafond v2 ≈ 200 k car. → 413 au-delà&lt;br&gt;&amp;nbsp;&amp;nbsp;• jeu de référence : 12 contrats × 14 types = 168 décisions&lt;br&gt;&amp;nbsp;&amp;nbsp;• gate d&#x27;éval = 12 appels ≈ &amp;lt; 1 €/fusion&lt;br&gt;&amp;nbsp;&amp;nbsp;• canary 10 → 50 → 100 % · fenêtre comptée en jours" style="text;html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=12;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="265" width="360" height="175" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Requête /v2 :&lt;/b&gt; texte · langue · types_clauses&lt;br&gt;&lt;br&gt;&lt;b&gt;Réponse /v2 :&lt;/b&gt;&lt;br&gt;request_id · version · modele · prompt_version&lt;br&gt;clauses[14] { type, presente, confiance }&lt;br&gt;score_confiance { global, libelle, calibre }&lt;br&gt;tronque (false) · couverture&lt;br&gt;consommation { cout_eur, latence_ms }" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#cfe2f3;strokeColor=#6fa8dc;strokeWidth=1;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="460" width="330" height="175" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Manifeste (dans l&#x27;image) :&lt;/b&gt;&lt;br&gt;git_sha · release_version · model_id daté&lt;br&gt;prompt_version · config_hash (température)&lt;br&gt;calibration_version + eval_score&lt;br&gt;golden_dataset_version · build_timestamp" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#cfe2f3;strokeColor=#6fa8dc;strokeWidth=1;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="650" width="330" height="120" as="geometry"/></mxCell><mxCell id="client" value="Outil documentaire&lt;br&gt;des juristes&lt;br&gt;&lt;br&gt;client_v1 (intact)&lt;br&gt;frontend v2" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#cfe2f3;strokeColor=#6fa8dc;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="450" y="150" width="140" height="150" as="geometry"/></mxCell><mxCell id="lb" value="Routeur&lt;br&gt;(LB)&lt;br&gt;&lt;br&gt;/v1 →&lt;br&gt;v1&lt;br&gt;&lt;br&gt;/v2 →&lt;br&gt;poids" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#cfe2f3;strokeColor=#6fa8dc;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="650" y="120" width="60" height="320" as="geometry"/></mxCell><mxCell id="ws3" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#cfe2f3;strokeColor=#6fa8dc;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="830" y="200" width="140" height="90" as="geometry"/></mxCell><mxCell id="ws2" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#cfe2f3;strokeColor=#6fa8dc;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="818" y="212" width="140" height="90" as="geometry"/></mxCell><mxCell id="ws1" value="v2 webserver&lt;br&gt;(stable tag N · canary tag N+1)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#cfe2f3;strokeColor=#6fa8dc;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="806" y="224" width="140" height="90" as="geometry"/></mxCell><mxCell id="v1" value="v1 webserver — FIGÉ&lt;br&gt;(jamais redéployé)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#cfe2f3;strokeColor=#6fa8dc;strokeWidth=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="806" y="360" width="140" height="60" as="geometry"/></mxCell><mxCell id="llm" value="API LLM externe (fournisseur)&lt;br&gt;model_id daté · température fixée&lt;br&gt;1 appel par analyse" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#cfe2f3;strokeColor=#6fa8dc;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="20" width="320" height="90" as="geometry"/></mxCell><mxCell id="metrics" value="Métriques par requête&lt;br&gt;(ops/metrics.jsonl)&lt;br&gt;latence · coût · erreur&lt;br&gt;score · route · tag" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fontFamily=Arial;fontSize=12;fillColor=#cfe2f3;strokeColor=#6fa8dc;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="560" y="600" width="190" height="130" as="geometry"/></mxCell><mxCell id="golden" value="Jeu de référence&lt;br&gt;(attendus.jsonl)&lt;br&gt;12 contrats · 14 types&lt;br&gt;seuil 0,75 / 0,8" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fontFamily=Arial;fontSize=12;fillColor=#cfe2f3;strokeColor=#6fa8dc;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="800" y="600" width="190" height="130" as="geometry"/></mxCell><mxCell id="registry" value="Registre d&#x27;images&lt;br&gt;(GHCR)&lt;br&gt;tags N, N+1, …&lt;br&gt;+ manifeste" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fontFamily=Arial;fontSize=12;fillColor=#cfe2f3;strokeColor=#6fa8dc;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1040" y="600" width="190" height="130" as="geometry"/></mxCell><mxCell id="cfg" value="Config en git :&lt;br&gt;thresholds.yml&lt;br&gt;weights.json · VERSION" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#cfe2f3;strokeColor=#6fa8dc;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1260" y="620" width="140" height="90" as="geometry"/></mxCell><mxCell id="chain" value="Chaîne llmops.yml (GitHub Actions)&lt;br&gt;branche → PR (tests ; gate d&#x27;éval si fichiers sensibles)&lt;br&gt;→ fusion sur main → tests (MOCK) → gate d&#x27;éval&lt;br&gt;→ build + manifeste → tag → push → canary 10 %" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#cfe2f3;strokeColor=#6fa8dc;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1040" y="190" width="300" height="100" as="geometry"/></mxCell><mxCell id="ch2" value="Chantier 2 (à venir) : tableau de bord ← métriques · dérive → alerte → rollback (clic humain) ·&lt;br&gt;promotion 10 → 50 → 100 pilotée par les métriques · cas à faible confiance → jeu de référence" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="800" y="790" width="600" height="60" as="geometry"/></mxCell><mxCell id="leg0" value="&lt;font color=&quot;#6fa8dc&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;process / data (Ch1)" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="30" y="865" width="154" height="26" as="geometry"/></mxCell><mxCell id="leg1" value="&lt;font color=&quot;#999999&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;Chantier 2 / à venir" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="194" y="865" width="154" height="26" as="geometry"/></mxCell><mxCell id="a1" value="POST texte" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1;fontFamily=Arial;fontSize=10;" edge="1" parent="1" source="client" target="lb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a2" value="/v2 · 90 / 10" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1;fontFamily=Arial;fontSize=10;" edge="1" parent="1" source="lb" target="ws1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a3" value="/v1" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1;fontFamily=Arial;fontSize=10;" edge="1" parent="1" source="lb" target="v1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a4" value="1 appel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1;fontFamily=Arial;fontSize=10;" edge="1" parent="1" source="ws3" target="llm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1;fontFamily=Arial;fontSize=10;" edge="1" parent="1" source="v1" target="llm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="985" y="375"/><mxPoint x="985" y="110"/></Array></mxGeometry></mxCell><mxCell id="a7" value="Mesure par requête (routeur + serveurs)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1;fontFamily=Arial;fontSize=10;" edge="1" parent="1" source="lb" target="metrics"><mxGeometry relative="1" as="geometry" x="0.3"></mxGeometry></mxCell><mxCell id="a8" value="pull du tag" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1;fontFamily=Arial;fontSize=10;dashed=1;strokeColor=#777777;fontColor=#555555;" edge="1" parent="1" source="registry" target="ws1"><mxGeometry relative="1" as="geometry" x="0.6"><Array as="points"><mxPoint x="1000" y="540"/><mxPoint x="1000" y="245"/></Array></mxGeometry></mxCell><mxCell id="a9" value="push image" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1;fontFamily=Arial;fontSize=10;" edge="1" parent="1" source="chain" target="registry"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a10" value="écrit weights.json" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1;fontFamily=Arial;fontSize=10;" edge="1" parent="1" source="chain" target="cfg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="300"/><mxPoint x="1300" y="560"/><mxPoint x="1330" y="560"/></Array></mxGeometry></mxCell><mxCell id="a11" value="gate d&#x27;éval" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1;fontFamily=Arial