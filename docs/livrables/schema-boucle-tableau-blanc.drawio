<mxfile host="app.diagrams.net" type="device"><diagram id="boucle-tableau-blanc" name="Boucle tableau blanc"><mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="&lt;b&gt;Chantier 2 — l&#x27;observabilité qui pilote&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;• 5 signaux : p95 · coût · erreurs · distribution du score · part v1/v2&lt;br&gt;&amp;nbsp;&amp;nbsp;• 3 boucles : rollback (humain) · promotion (auto) · enrichissement&lt;br&gt;&amp;nbsp;&amp;nbsp;• 1 journal de pilotage · 1 fichier de seuils" style="text;html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=12;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="380" height="95" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Cas d&#x27;usage :&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;• voir la production sur un tableau de bord&lt;br&gt;&amp;nbsp;&amp;nbsp;• être alerté quand le canary dérive → reculer en un clic&lt;br&gt;&amp;nbsp;&amp;nbsp;• avancer 10 → 50 → 100 % seulement si les chiffres tiennent&lt;br&gt;&amp;nbsp;&amp;nbsp;• transformer les cas ratés en cas de test" style="text;html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=12;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="125" width="380" height="100" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Chiffres :&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;• ~20 requêtes/jour · canary à 10 % ≈ 2/jour → fenêtre en jours&lt;br&gt;&amp;nbsp;&amp;nbsp;• fenêtre : 50 requêtes ou 2 jours · minimum 30&lt;br&gt;&amp;nbsp;&amp;nbsp;• alerte : p95 &amp;gt; 8 s · erreurs &amp;gt; 10 % · part &amp;lt; 0,5 &amp;gt; signature + 15 pts · médiane &amp;lt; signature − 0,15&lt;br&gt;&amp;nbsp;&amp;nbsp;• promotion : canary ≤ stable + 2 pts d&#x27;erreurs · + 5 pts de part basse · médiane ≥ stable − 0,05 · coût ≤ 0,15 €&lt;br&gt;&amp;nbsp;&amp;nbsp;• watcher : toutes les 60 s (démo) / 10 min (prod)&lt;br&gt;&amp;nbsp;&amp;nbsp;• capture : score &amp;lt; 0,5 ou calibre = false ≈ 2 à 4 cas/jour&lt;br&gt;&amp;nbsp;&amp;nbsp;• détecteur mesuré : taux de détection ET fausses alertes" style="text;html=1;align=left;verticalAlign=top;fontFamily=Arial;fontSize=12;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="235" width="380" height="165" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Ligne de journal :&lt;/b&gt; ts · événement · tag · signal · valeur · seuil · fenêtre · action · acteur · commit&lt;br&gt;&lt;b&gt;Événements :&lt;/b&gt; alerte · rollback · promotion · refus_promotion · ajustement_seuil · donnees_insuffisantes · capture · enrichissement" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#cfe2f3;strokeColor=#6fa8dc;strokeWidth=1;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="420" width="380" height="90" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Signature d&#x27;une release (manifeste) :&lt;/b&gt; médiane et part &amp;lt; 0,5 sur les 12 contrats de référence, au gate&lt;br&gt;&lt;b&gt;Dérive :&lt;/b&gt; la distribution en production s&#x27;éloigne de la signature (alerte) ; le canary est comparé à la stable sur la même fenêtre (promotion)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#cfe2f3;strokeColor=#6fa8dc;strokeWidth=1;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="525" width="380" height="100" as="geometry"/></mxCell><mxCell id="prod" value="Production (Chantier 1)&lt;br&gt;routeur · v1 figé · v2 stable · v2 canary&lt;br&gt;une Mesure par requête" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#cfe2f3;strokeColor=#6fa8dc;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="470" y="40" width="220" height="90" as="geometry"/></mxCell><mxCell id="metrics" value="ops/metrics.jsonl&lt;br&gt;latence · coût · erreur&lt;br&gt;score · route · tag" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fontFamily=Arial;fontSize=12;fillColor=#cfe2f3;strokeColor=#6fa8dc;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="470" y="200" width="220" height="120" as="geometry"/></mxCell><mxCell id="watcher" value="Watcher&lt;br&gt;(ops/watcher.py)&lt;br&gt;&lt;br&gt;fenêtre → 5 signaux&lt;br&gt;→ seuils&lt;br&gt;→ décision" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#cfe2f3;strokeColor=#6fa8dc;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="750" y="180" width="130" height="160" as="geometry"/></mxCell><mxCell id="thr" value="thresholds.yml&lt;br&gt;(git)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#cfe2f3;strokeColor=#6fa8dc;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="750" y="400" width="130" height="60" as="geometry"/></mxCell><mxCell id="dash" value="Tableau de bord&lt;br&gt;(ops/dashboard.py étendu)&lt;br&gt;5 signaux · état · journal · bouton rollback" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#cfe2f3;strokeColor=#6fa8dc;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="940" y="40" width="260" height="90" as="geometry"/></mxCell><mxCell id="alerte" value="ALERTE&lt;br&gt;bannière + journal" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#f4cccc;strokeColor=#e06666;" vertex="1" parent="1"><mxGeometry x="940" y="190" width="130" height="60" as="geometry"/></mxCell><mxCell id="humain" value="Chef de projet&lt;br&gt;un clic, nom saisi" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1110" y="190" width="130" height="60" as="geometry"/></mxCell><mxCell id="redeploy" value="redeploy(previous_tag)&lt;br&gt;→ weights.json 100 % tag précédent" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1280" y="190" width="180" height="60" as="geometry"/></mxCell><mxCell id="promo" value="set_weight(palier suivant)&lt;br&gt;10 → 50 → 100 % — automatique" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#cfe2f3;strokeColor=#6fa8dc;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="940" y="290" width="200" height="60" as="geometry"/></mxCell><mxCell id="refus" value="promotion refusée&lt;br&gt;journal + critère en échec" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1170" y="290" width="150" height="60" as="geometry"/></mxCell><mxCell id="weights" value="weights.json&lt;br&gt;(poids canary)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#cfe2f3;strokeColor=#6fa8dc;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1360" y="290" width="100" height="60" as="geometry"/></mxCell><mxCell id="capture" value="Capture : score &amp;lt; 0,5 ou calibre = false&lt;br&gt;→ candidats.jsonl (masqué)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#cfe2f3;strokeColor=#6fa8dc;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="940" y="400" width="220" height="60" as="geometry"/></mxCell><mxCell id="etiq" value="Étiquetage par un juriste" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1190" y="400" width="130" height="60" as="geometry"/></mxCell><mxCell id="attendus" value="attendus.jsonl&lt;br&gt;version N+1 — commit" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#cfe2f3;strokeColor=#6fa8dc;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1350" y="400" width="110" height="60" as="geometry"/></mxCell><mxCell id="gate" value="Gate d&#x27;évaluation (Chantier 1) — sur la PR, puis à la fusion → recalibration" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="940" y="500" width="300" height="50" as="geometry"/></mxCell><mxCell id="journal" value="ops/journal.jsonl&lt;br&gt;append-only&lt;br&gt;chaque décision" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fontFamily=Arial;fontSize=12;fillColor=#cfe2f3;strokeColor=#6fa8dc;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="750" y="500" width="130" height="110" as="geometry"/></mxCell><mxCell id="traces" value="Traces OTel → OTLP → Jaeger&lt;br&gt;(diagnostic par request_id)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="470" y="400" width="220" height="60" as="geometry"/></mxCell><mxCell id="tune" value="Ajustement des seuils : après 100 % ou hebdo → PR thresholds.yml (gate rejoué) → merge = trace" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=11;fillColor=#f3f3f3;strokeColor=#999999;dashed=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1280" y="500" width="180" height="80" as="geometry"/></mxCell><mxCell id="leg0" value="&lt;font color=&quot;#6fa8dc&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;process / data (Ch2)" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="30" y="635" width="154" height="26" as="geometry"/></mxCell><mxCell id="leg1" value="&lt;font color=&quot;#999999&quot;&gt;&amp;#9679;&lt;/font&gt;&a