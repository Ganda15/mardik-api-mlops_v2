<mxfile host="app.diagrams.net" type="device"><diagram id="boucle-observabilite" name="Boucle observabilite"><mxGraphModel dx="1600" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titre" value="Mardik v2 — Boucle d&#x27;observabilité (Chantier 2) : signaux → seuils → les trois rétroactions vers la chaîne" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1460" height="30" as="geometry"/></mxCell><mxCell id="cP" value="PRODUCTION (Chantier 1) — chaque requête, sur chaque route, écrit une Mesure" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;fontSize=13;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1230" height="150" as="geometry"/></mxCell><mxCell id="routeur" value="Routeur — /v1 → v1 · /v2 → poids lus dans weights.json" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="100" width="300" height="80" as="geometry"/></mxCell><mxCell id="v1" value="v1 — FIGÉ" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="100" width="150" height="80" as="geometry"/></mxCell><mxCell id="v2s" value="v2 stable — tag N" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="580" y="100" width="170" height="80" as="geometry"/></mxCell><mxCell id="v2c" value="v2 canary — tag N+1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="780" y="100" width="170" height="80" as="geometry"/></mxCell><mxCell id="weights" value="weights.json (poids canary)&lt;br&gt;écrit par la chaîne, set_weight, redeploy" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1300" y="110" width="200" height="80" as="geometry"/></mxCell><mxCell id="thr" value="thresholds.yml (git)&lt;br&gt;seuils, marges, fenêtres, paliers, critères" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1300" y="270" width="200" height="80" as="geometry"/></mxCell><mxCell id="tune" value="Ajustement des seuils : après une promotion à 100 % ou chaque semaine&lt;br&gt;distributions observées → PR (gate rejoué) → merge = trace&lt;br&gt;la version promue = nouvelle baseline" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1300" y="410" width="200" height="120" as="geometry"/></mxCell><mxCell id="journal" value="ops/journal.jsonl — append-only&lt;br&gt;ts · événement · tag · signal · valeur · seuil · fenêtre · action · acteur · commit" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1300" y="590" width="200" height="100" as="geometry"/></mxCell><mxCell id="metrics" value="ops/metrics.jsonl — une ligne par requête : ts · version/tag · route · latence_ms · erreur · score · cout_eur · tokens · tronque&lt;br&gt;(source fournie — la seule lue par le tableau de bord et la surveillance)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="560" height="80" as="geometry"/></mxCell><mxCell id="dash" value="TABLEAU DE BORD (ops/dashboard.py étendu) : p95 · coût · taux d&#x27;erreur · distribution du score (déciles, part &amp;lt; 0,5) · part v1/v2 · journal · bannière d&#x27;alerte · bouton rollback" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="640" y="270" width="300" height="80" as="geometry"/></mxCell><mxCell id="traces" value="Traces OpenTelemetry → OTLP → Jaeger&lt;br&gt;(diagnostic par request_id — pas un signal de pilotage)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="980" y="270" width="280" height="80" as="geometry"/></mxCell><mxCell id="watcher" value="WATCHER — ops/watcher.py, son conteneur, toutes les 60 s (démo) / 10 min (prod)&lt;br&gt;lit la fenêtre par tag (50 requêtes ou 2 jours, minimum 30) · calcule p95, taux d&#x27;erreur, part des scores &amp;lt; 0,5, médiane, coût moyen, part v1/v2&lt;br&gt;compare à thresholds.yml · écrit journal.jsonl · met à jour l&#x27;état du tableau de bord · peut appeler set_weight · &lt;b&gt;ne peut jamais appeler redeploy&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="700" height="110" as="geometry"/></mxCell><mxCell id="capture" value="Capture : score global &amp;lt; 0,5 ou calibre = false&lt;br&gt;→ ops/candidats.jsonl (noms et montants masqués)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="780" y="470" width="260" height="60" as="geometry"/></mxCell><mxCell id="etiq" value="Étiquetage par un juriste : clauses attendues" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#555555;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="780" y="580" width="260" height="50" as="geometry"/></mxCell><mxCell id="attendus" value="attendus.jsonl version N+1 — commit" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="780" y="670" width="260" height="50" as="geometry"/></mxCell><mxCell id="gate" value="Gate d&#x27;évaluation (Chantier 1) — sur la PR d&#x27;enrichissement, puis à la fusion&lt;br&gt;→ nouvelle calibration → manifeste (golden_dataset_version N+1)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="780" y="760" width="260" height="75" as="geometry"/></mxCell><mxCell id="d0" value="≥ 30 requêtes dans la fenêtre ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="250" y="590" width="220" height="80" as="geometry"/></mxCell><mxCell id="insuff" value="état : données insuffisantes — aucune décision, affiché tel quel" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="600" width="190" height="60" as="geometry"/></mxCell><mxCell id="d1" value="un signal de rollback franchi ?&lt;br&gt;p95 &amp;gt; 8 s · erreurs &amp;gt; 10 % · part &amp;lt; 0,5 &amp;gt; signature + 15 pts · médiane &amp;lt; signature − 0,15" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="280" height="110" as="geometry"/></mxCell><mxCell id="d2" value="critères de promotion tous tenus ?&lt;br&gt;≥ 30 req et ≥ 1 jour · p95 ≤ 8 s · erreurs ≤ stable + 2 pts · part &amp;lt; 0,5 ≤ stable + 5 pts · médiane ≥ stable − 0,05 · coût ≤ 0,15 €" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="380" y="740" width="300" height="110" as="geometry"/></mxCell><mxCell id="alerte" value="ALERTE — bannière + ligne de journal" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="910" width="280" height="55" as="geometry"/></mxCell><mxCell id="humain" value="Décision humaine : le chef de projet, un clic, nom saisi → ligne de journal (acteur)&lt;br&gt;(arbitrage du CTO : jamais automatique)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#555555;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1005" width="280" height="70" as="geometry"/></mxCell><mxCell id="redeploy" value="redeploy(previous_tag) — entrée de la chaîne (Chantier 1)&lt;br&gt;100 % de /v2 vers un tag déjà validé · rien n&#x27;est reconstruit" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="1115" width="280" height="70" as="geometry"/></mxCell><mxCell id="promo" value="set_weight(palier suivant) : 10 → 50 → 100 %&lt;br&gt;automatique — acteur = watcher → ligne de journal" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="910" width="300" height="60" as="geometry"/></mxCell><mxCell id="refus" value="promotion refusée — ligne de journal avec le critère en échec&lt;br&gt;2 refus consécutifs → alerte pour décision humaine" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="380" y="1005" width="300" height="60" as="geometry"/></mxCell><mxCell id="leg0" value="&lt;font color=&quot;#82b366&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nbsp;production (Ch1)" style="rounded=1;whiteSpace=nowrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;fontSize=11;fontColor=#3c4043;align=left;spacingLeft=8;verticalAlign=middle;arcSize=40;" vertex="1" parent="1"><mxGeometry x="40" y="1235" width="128" height="26" as="geometry"/></mxCell><mxCell id="leg1" value="&lt;font color=&quot;#d6b656&quot;&gt;&amp;#9679;&lt;/font&gt;&amp;nb