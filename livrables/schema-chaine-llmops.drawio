<mxfile host="app.diagrams.net" type="device"><diagram id="chaine-llmops" name="Chaine LLMOps"><mxGraphModel dx="1400" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titre" value="Mardik v2 — Chaîne LLMOps (Chantier 1) : de la branche à la fusion, puis gates bloquants → build → canary" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1260" height="30" as="geometry"/></mxCell><mxCell id="cPre" value="AVANT LA FUSION — poste dev → GitHub (PR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;fontSize=13;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="20" y="35" width="640" height="280" as="geometry"/></mxCell><mxCell id="pm_dev" value="Poste dev&lt;br&gt;commit local" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e6e6fa;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="150" height="55" as="geometry"/></mxCell><mxCell id="pm_branche" value="Push → branche courte&lt;br&gt;jamais de push direct sur main" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e6e6fa;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="220" y="65" width="210" height="55" as="geometry"/></mxCell><mxCell id="pm_pr" value="Pull Request → main&lt;br&gt;auto-revue + revue automatisée" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e6e6fa;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="460" y="65" width="170" height="55" as="geometry"/></mxCell><mxCell id="pm_chk1" value="Checks systématiques (gratuits)&lt;br&gt;job 1 : tests unitaires, contrat, erreurs,&lt;br&gt;rejeu client_v1.py, intégration remédiation — MOCK=on&lt;br&gt;à chaque push sur la PR" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e6e6fa;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="290" height="105" as="geometry"/></mxCell><mxCell id="pm_chk2" value="Gate d&#x27;évaluation (payant, conditionnel)&lt;br&gt;job 2 : seulement si la PR touche&lt;br&gt;models/v2/config.yaml, prompts/, le code d&#x27;analyse,&lt;br&gt;attendus.jsonl ou thresholds.yml (filtre de chemin)&lt;br&gt;— 12 appels au modèle réel" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e6e6fa;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="350" y="145" width="290" height="105" as="geometry"/></mxCell><mxCell id="pm_d0" value="checks requis verts ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="190" y="265" width="180" height="55" as="geometry"/></mxCell><mxCell id="pm_stop" value="FUSION BLOQUÉE" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="410" y="270" width="140" height="45" as="geometry"/></mxCell><mxCell id="pme0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="pm_dev" target="pm_branche"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pme1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="pm_branche" target="pm_pr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pme2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="pm_pr" target="pm_chk1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pme3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;stro