# Application
APP_ENV=development
LOG_LEVEL=INFO

# Model API
API_HOST=0.0.0.0
API_PORT=8000

# LLM (Azure AI Inference)
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_MODEL=Kimi-K2.6

# Artifact registry (mock — MinIO in docker-compose)
REGISTRY_ENDPOINT=http://localhost:9000
REGISTRY_ACCESS_KEY=mardik
REGISTRY_SECRET_KEY=mardik-secret
REGISTRY_BUCKET=model-artifacts
